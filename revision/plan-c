import csv
import json
import os

try:
    import pandas as pd
except ImportError:
    pd = None

class LectorCSV:
    """Lector para archivos en formato CSV."""
    def __init__(self, ruta_archivo: str):
        self.ruta_archivo = ruta_archivo

    def leer(self) -> list:
        registros = []
        if not os.path.exists(self.ruta_archivo):
            raise FileNotFoundError(f"El archivo CSV no existe: {self.ruta_archivo}")
        
        with open(self.ruta_archivo, mode='r', encoding='utf-8') as archivo:
            lector = csv.DictReader(archivo)
            for fila in lector:
                registros.append(dict(fila))
        return registros


class LectorJSON:
    """Lector para archivos en formato JSON."""
    def __init__(self, ruta_archivo: str):
        self.ruta_archivo = ruta_archivo

    def leer(self) -> list:
        if not os.path.exists(self.ruta_archivo):
            raise FileNotFoundError(f"El archivo JSON no existe: {self.ruta_archivo}")
        
        with open(self.ruta_archivo, mode='r', encoding='utf-8') as archivo:
            datos = json.load(archivo)
            # Asegurar que devuelva una lista de diccionarios
            if isinstance(datos, list):
                return datos
            elif isinstance(datos, dict):
                return [datos]
            return []


class LectorExcel:
    """Lector para archivos en formato Excel (.xlsx)."""
    def __init__(self, ruta_archivo: str):
        self.ruta_archivo = ruta_archivo

    def leer(self) -> list:
        if pd is None:
            raise ImportError("La librería 'pandas' y 'openpyxl' son necesarias para leer archivos Excel.")
        if not os.path.exists(self.ruta_archivo):
            raise FileNotFoundError(f"El archivo Excel no existe: {self.ruta_archivo}")
        
        df = pd.read_excel(self.ruta_archivo)
        # Convertir el DataFrame de pandas a una lista de diccionarios limpiando nulos de tipo NaN
        df = df.where(pd.notnull(df), None)
        return df.to_dict(orient='records')